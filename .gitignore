# Retired assets. Kept on disk so a replaced image can be compared or restored,
# but excluded from the repo so 3 MB of superseded photography and the retired
# React bundle stop shipping on every deploy. Anything quarantined after it was
# already committed remains recoverable from git history.
assets/_do-not-use/
blog/images/

# iCloud Drive conflict copies. This project lives in ~/Desktop, which iCloud
# syncs, and iCloud resolves a write-during-sync by duplicating the file with a
# " 2" suffix. 114 of them reached a commit before this rule existed, and one
# of them silently replaced blog/fine-lines-vs-wrinkles.html, breaking six
# internal links. Never track them.
* 2.*
* 3.*

# Built asset directory for the Cloudflare Worker — produced from git HEAD
cloudflare/public/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# iCloud conflict copies, with or without an extension
* [0-9]
* [0-9].*
